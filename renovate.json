{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bright-room/renovate-config"
  ],
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "osvVulnerabilityAlerts": true,
  "flux": {
    "managerFilePatterns": [
      "/manifests/.+\\.ya?ml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/manifests/.+/kustomization\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise tools"
    },
    {
      "matchManagers": [
        "flux"
      ],
      "pinDigests": false
    },
    {
      "matchPackageNames": [
        "k3s-io/k3s"
      ],
      "groupName": "k3s"
    },
    {
      "matchPackageNames": [
        "rancher/system-upgrade-controller"
      ],
      "groupName": "system-upgrade-controller"
    },
    {
      "matchPackageNames": [
        "coredns/coredns",
        "prometheus/node_exporter",
        "grafana/alloy"
      ],
      "extractVersion": "^v(?<version>.+)$"
    }
  ],
  "customManagers": [
    {
      "description": "Packer の variable ブロック。共通 preset の generic manager は .pkr.hcl を対象にしておらず、値も comment の直下行ではないため個別に定義する",
      "customType": "regex",
      "managerFilePatterns": [
        "/imager/variables\\.pkr\\.hcl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) versioning=(?<versioning>.*?)\\nvariable \"[^\"]+\" \\{\\n(?:.*\\n)*?\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "system-upgrade-controller の release URL。key: value 形式ではないので共通 preset の generic manager では拾えない",
      "customType": "regex",
      "managerFilePatterns": [
        "/manifests/platform/system-upgrade-controller/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) versioning=(?<versioning>.*?)\\n\\s*-\\s*https://github\\.com/[^/]+/[^/]+/releases/download/(?<currentValue>v[0-9.]+)/"
      ]
    }
  ]
}
