    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "authority (Host header) 別リクエスト件数の上位 10。どのサービスに流れているかの概観。",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
