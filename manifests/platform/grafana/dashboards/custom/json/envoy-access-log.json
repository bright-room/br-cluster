        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "quantile_over_time(0.50, {service_name=\"envoy-access-log\"} | envoy_proxy_name=~\"$proxy\" | authority=~\"$authority\" | unwrap duration [$__auto]) by (envoy_proxy_name)",
          "legendFormat": "p50 {{envoy_proxy_name}}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"envoy-access-log\"} | envoy_proxy_name=~\"$proxy\" | authority=~\"$authority\" | unwrap duration [$__auto]) by (envoy_proxy_name)",
          "legendFormat": "p95 {{envoy_proxy_name}}",
          "queryType": "range",
          "refId": "B"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "quantile_over_time(0.99, {service_name=\"envoy-access-log\"} | envoy_proxy_name=~\"$proxy\" | authority=~\"$authority\" | unwrap duration [$__auto]) by (envoy_proxy_name)",
          "legendFormat": "p99 {{envoy_proxy_name}}",
          "queryType": "range",
          "refId": "C"
        }
