      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "topk(10, sum by (reason) (count_over_time({job=\"kubernetes-events\", namespace=~\"$namespace\"}[$__range])))",
          "instant": true,
          "legendFormat": "{{reason}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top reasons (range 内)",
      "type": "barchart"
    },
