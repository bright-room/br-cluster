---
# Run only on first-party content; vendored collections/roles are skipped.
exclude_paths:
  - provisioner/collections/
  - provisioner/roles/ipr-cnrs.nftables/
  - .secret/
  - .generated/

# vendored role を mock 扱いにして playbook 側の syntax-check を通す
mock_roles:
  - ipr-cnrs.nftables

# yaml rules are checked by yamllint job separately
skip_list:
  - yaml[line-length]
  # TODO: roles/secrets/ の内部変数 (`secret_*`, `_op_*`, `_restic_*`) を
  # role 名 prefix の `secrets_` に揃え、task key 並びを canonical
  # (name, run_once, when, become, block) に整えてこの skip を外す。
  - var-naming[no-role-prefix]
  - key-order[task]
  # TODO: playbook 内の `import_role: name: bootstrap/verify_nodes` 形式を
  # `bootstrap/` を分離した独立 role か collection FQRN に置き換えて外す。
  - role-name[path]
  # TODO: roles/*/handlers/main.yaml の handler 名を大文字始まりに直して外す。
  - name[casing]

profile: moderate
