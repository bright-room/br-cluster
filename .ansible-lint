---
# Run only on first-party content; vendored collections/roles are skipped.
exclude_paths:
  - provisioner/collections/
  - provisioner/roles/ipr-cnrs.nftables/
  - .secret/
  - .generated/
  # cluster-forge generate-inventory が生成する gitignore 済ファイル。
  # CI checkout には存在しないが、ローカルでは ansible-lint に拾われるため除外する。
  # ansible-lint は provisioner/ から起動するので相対パス両方を列挙。
  - inventories/dev/group_vars/all/cluster_hosts.yaml
  - inventories/prod/group_vars/all/cluster_hosts.yaml

# vendored role を mock 扱いにして playbook 側の syntax-check を通す
mock_roles:
  - ipr-cnrs.nftables

# yaml rules are checked by yamllint job separately
skip_list:
  - yaml[line-length]
  # `roles/bootstrap/<area>/` のサブディレクトリ配置は意図的な構成
  # (bootstrap 関連の役割を 1 グループにまとめる)。ここは flat 化しない。
  - role-name[path]
  # TODO: roles/{common,garage,caddy,certbot,postgresql,gateway,k3s,bootstrap/*}
  # 内の変数 prefix を role 名に揃えてこの skip を外す。
  # (roles/secrets/ は対応済み)
  - var-naming[no-role-prefix]

profile: moderate
