---
# Run only on first-party content; vendored collections/roles are skipped.
exclude_paths:
  - provisioner/collections/
  - provisioner/roles/ipr-cnrs.nftables/
  - .secret/
  - .generated/

# vendored role を mock 扱いにして playbook 側の syntax-check を通す
mock_roles:
  - ipr-cnrs.nftables

# yaml rules are checked by yamllint job separately
skip_list:
  - yaml[line-length]

profile: moderate
