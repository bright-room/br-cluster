### secrets ###
# {env}/ の箱だけ残す (cluster-forge は .secret/{env}/ を読むだけで作らない)。
# `.secret/` 自体を除外すると git が配下に降りず .gitkeep の再包含が効かなくなる
.secret/**
!.secret/dev/
!.secret/prod/
!.secret/dev/.gitkeep
!.secret/prod/.gitkeep
.kube/

### generated ###
.generated/
# keys/ の箱だけ残す。`docker/ssh` 自体を除外すると git が配下に降りず
# !docker/ssh/keys/.gitkeep が効かなくなる (除外ディレクトリ配下は再包含できない)
docker/ssh/**
!docker/ssh/keys/
!docker/ssh/keys/.gitkeep

### ansible ###
provisioner/roles/ipr-cnrs.nftables/
provisioner/collections/ansible_collections/
# Generated inventory files (by cluster-forge generate-inventory)
provisioner/inventories/*/hosts.yaml
!provisioner/inventories/base/hosts.yaml
provisioner/inventories/*/group_vars/all/cluster_hosts.yaml
provisioner/inventories/*/host_vars/br-gateway1.yaml
# base/ は生成対象外 (generate-inventory の書き込み先は inventories/{env}/)。
# 手書きの nftables 設定なので追跡する
!provisioner/inventories/base/host_vars/br-gateway1.yaml

