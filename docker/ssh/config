CanonicalizeHostname yes
Include ~/.ssh/1Password/config

Host *
  StrictHostKeyChecking accept-new
  UserKnownHostsFile /root/.ssh/known_hosts

Host br-gateway1
  HostName 192.168.2.50
  Port 22
  User bradmin
  IdentitiesOnly yes
  IdentityFile /root/.ssh/keys/br-gateway1.pub

Host br-node1
  HostName 172.22.10.10
  Port 22
  User bradmin
  ProxyJump br-gateway1
  IdentitiesOnly yes
  IdentityFile /root/.ssh/keys/br-node1.pub

