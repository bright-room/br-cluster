{% set ext = cluster_hosts | selectattr('name', 'equalto', 'br-external1') | first %}
{
    auto_https off
    admin off
}

{{ ext.domains.backup_storage }}:{{ garage.server.s3_port }} {
    bind {{ ext.ip }}
    tls {{ garage.ssl_dir }}/public.crt {{ garage.ssl_dir }}/private.key
    reverse_proxy 127.0.0.1:{{ garage.server.s3_port }}
}
