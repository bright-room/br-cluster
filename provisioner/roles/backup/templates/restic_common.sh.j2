export RESTIC={{ restic.binary_path }}

export RESTIC_REPOSITORY={{ restic_config.environment.repository }}
export RESTIC_PASSWORD={{ secret_restic_password }}

export LOG_FILE={{ restic_config.environment.log_dir_path }}/{{ restic_config.environment.log_file_prefix }}_$(date +%Y%m%d).log

export AWS_ACCESS_KEY_ID={{ secret_restic_s3_access_key }}
export AWS_SECRET_ACCESS_KEY={{ secret_restic_s3_secret_key }}

function timestamp() {
  date "+%Y-%m-%d'T'%H:%M:%S"
}
