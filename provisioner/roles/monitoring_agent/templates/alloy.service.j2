[Unit]
Description=Grafana Alloy (systemd-journald → Loki)
Documentation=https://grafana.com/docs/alloy/
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
User=alloy
# systemd-journal group grants read access to /var/log/journal.
Group=systemd-journal
ExecStart={{ install_dir }}/alloy run {{ alloy_journal.config_dir }}/config.alloy \
  --storage.path={{ alloy_journal.data_dir }} \
  --server.http.listen-addr={{ alloy_journal.http_listen_addr }}
Restart=always
RestartSec=5

# Low-risk hardening: Alloy only needs to read the journal and make outbound
# HTTP calls. It does not need to touch the rest of the filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ alloy_journal.data_dir }}
PrivateTmp=true

[Install]
WantedBy=multi-user.target
