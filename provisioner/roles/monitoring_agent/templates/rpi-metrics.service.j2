[Unit]
Description=Collect Raspberry Pi host metrics (throttle / ARM clock / core volts) via vcgencmd
After=node_exporter.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/rpi-metrics.sh
# Defense-in-depth: kill the unit if a wedged vchiq keeps the script alive
# past its internal vcgencmd timeouts.
TimeoutStartSec=20s
