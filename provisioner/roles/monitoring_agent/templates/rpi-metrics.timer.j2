[Unit]
Description=Run rpi-metrics every 60 seconds

[Timer]
# Longer interval than a typical scrape (30s) — vcgencmd hits the GPU mailbox
# which has historically been brittle on Pi firmware; 60s is conservative.
# Prometheus scrapes the same value twice before a refresh (acceptable
# staleness for throttle/voltage signals).
OnBootSec=60s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
