#!/usr/bin/env bash
# Managed by Ansible (role: k3s_leader_restart). Do not edit manually.
#
# Abort (exit 1) unless all peer control-plane nodes are:
#   1. reachable and reporting healthy apiserver + etcd
#   2. not themselves freshly restarted (prevents cascade rotation)
set -euo pipefail

MIN_PEER_UPTIME_SEC={{ k3s_leader_restart.min_peer_uptime_sec }}

declare -A PEERS=(
{% for peer in groups['master'] if peer != inventory_hostname %}
{%   set peer_ip = (cluster_hosts | selectattr('name', 'equalto', peer) | first).ip %}
  ["{{ peer }}"]="{{ peer_ip }}"
{% endfor %}
)

now=$(date +%s)

for name in "${!PEERS[@]}"; do
  ip="${PEERS[$name]}"

  if ! curl -sfk --max-time 5 "https://${ip}:6443/livez" >/dev/null; then
    echo "FAIL: ${name} (${ip}) apiserver unhealthy" >&2
    exit 1
  fi

  if ! curl -sf --max-time 5 "http://${ip}:2381/health" >/dev/null; then
    echo "FAIL: ${name} (${ip}) etcd unhealthy" >&2
    exit 1
  fi

  start=$(curl -sf --max-time 5 "http://${ip}:2381/metrics" \
    | awk '/^process_start_time_seconds / {print $2; exit}')
  if [[ -z "${start:-}" ]]; then
    echo "FAIL: ${name} (${ip}) could not read process_start_time_seconds" >&2
    exit 1
  fi
  age=$(awk "BEGIN{print int(${now} - ${start})}")
  if (( age < MIN_PEER_UPTIME_SEC )); then
    echo "ABORT: ${name} restarted ${age}s ago (< ${MIN_PEER_UPTIME_SEC}s)" >&2
    exit 1
  fi
done

echo "peers healthy and stable"
