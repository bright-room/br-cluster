#!/usr/bin/env bash
# Managed by Ansible (role: k3s_leader_restart). Do not edit manually.
#
# Entry point invoked by k3s-leader-restart.service (daily timer).
# Exits 0 on both "restarted k3s" and "skipped" so the unit isn't marked failed
# during normal no-op runs. Use journalctl -u k3s-leader-restart to audit.
set -euo pipefail

skip() {
  echo "SKIP: $*"
  exit 0
}

/usr/local/bin/k3s-leader-restart-check-peers.sh || skip "peers unhealthy or recently restarted"
/usr/local/bin/k3s-leader-restart-check-self.sh  || skip "not a leader"

echo "RESTART: k3s"
exec /bin/systemctl restart k3s
