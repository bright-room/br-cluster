# CI fixture: Flux Kustomization spec.postBuild.substituteFrom で展開される
# 変数の dummy 値テーブル (kubeconform 検査用)。
#
# 用途: scripts/manifests-build.sh が `kustomize build` 出力を envsubst に
# 通し、ここに列挙された変数だけ展開してから kubeconform に流す。値は
# 「文法的に valid な dummy」で、prod 値とは無関係。
#
# 維持: manifest 中で新しい ${VAR} を Flux postBuild 経由で参照し始めたら
# ここに 1 行追加する。Argo Workflow 内のシェル変数 (`${WORKFLOW_NAME}` 等)
# や Grafana テンプレ変数 (`${DS_EXPRESSION}`) は postBuild 対象外なので
# 列挙しないこと — envsubst の allow-list として機能する。
#
# 値が prod と乖離していても CI は通る (schema check のみ)。
# 同期が必要になったら manifests/clusters/prod/config/cluster-settings.yaml
# 等の値と見比べる。

ACME_EMAIL=ci@example.com
CLOUDFLARED_TUNNEL_CNAME=ci-tunnel.cfargotunnel.com
CLOUDFLARED_TUNNEL_ID=00000000-0000-0000-0000-000000000000
CLUSTER_DOMAIN=cluster.example.com
CLUSTER_GATEWAY_IP=10.0.0.1
CLUSTER_INTERNAL_DOMAIN=internal.example.com
COREDNS_ETCD_URL=http://coredns-etcd.example.com:2379
INTERNAL_CLUSTER_GATEWAY_IP=10.0.0.2
KUBE_VIP_ADDRESS=10.0.0.3
